# ============================================
# Application
# ============================================
APP_NAME=Flowers Shop API
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=DEBUG

# ============================================
# Database
# ============================================
# Добавь или проверь эти строки в .env
DB_USER=пользовтель ДБ
DB_PASSWORD=пароль ДБ        
DB_NAME=имя ДБ

# Убедись, что строка подключения использует эти переменные или совпадает с паролем выше:
DATABASE_URL=postgresql+asyncpg://flowers_user:password@db:5432/flowers

DATABASE_URL=postgresql+asyncpg://flowers_user:password@db:5432/flowers

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# Security
# ============================================
JWT_SECRET_KEY=change_this_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Bot token
# ============================================

BOT_TOKEN=твой_реальный_токен_от_BotFather
BOT_USERNAME=bot_user
BOT_PASSWORD=bot_password
